{
    "length": 50,
    "numSegments": 80,
    "basePosition": [5, 55, 130],
    "directionVector": [0, 1, 0],
    "radius": 0.3,
    "youngModulus": 5e17,
    "poissonRatio": 0.3,
    "totalMass": 2e-5,
    "attachmentPoint": "tip",
    "springStiffness": 2e6,
    "angularStiffness": 1e13,
    "hasVisual": true,
    "collision": { "models": ["line"], "groups": [2] },
    "controller": {
        "mode": "haptics",
        "driverType": "Haply",

        "scale": 500,
        "positionBase": [37.5, -34.25, 143.75],
 
        /* This configuration works with SofaHaplyRobotics main branch*/
        "orientationBase": [-0.5, -0.5, -0.5, 0.5],

        /* The calibration is done by pointing the stylus perpendicular to the device*/
        // "calibrationOrientation": [0, 0, 0, 1],

        /* The calibration is done with the stylus level, parallel to the device and pointing at the screen, buttons up*/
        "calibrationOrientation": [0, 0, 0.7071068, 0.7071068],

        /* In the SofaHaplyRobotics fix_orientation branch, the calibrationOrientation ends up expressed in the SOFA frame.*/
        /* Thus we get orientationBase * the main branch value*/
        /* The calibration is done by pointing the stylus perpendicular to the device*/
        //"calibrationOrientation": [-0.5, -0.5, -0.5, 0.5],

        /* The calibration is done with the stylus level, parallel to the device and pointing at the screen, buttons up*/
        // "calibrationOrientation": [-0.7071068, 0, 0, 0.7071068],

        "forceCoef": 2.4e-6,
        "draw": true,
        "visualization": {
            "stylus": { "filename": "mesh/haply/Stylus.obj" },
            "body":   { "filename": "mesh/haply/Inverse3.obj" }
        }
    },
    "solvers": {
        "odeSolver":    { "type": "EulerImplicitSolver", "firstOrder": true },
        "linearSolver": { "type": "SparseLDLSolver", "template": "CompressedRowSparseMatrixMat3x3d" },
        "correction":   { "type": "LinearSolverConstraintCorrection", "template": "Rigid3d" }
    },
    "insertion": {
        "tipDistThreshold": 2,
        "contactDistance": 0.1,
        "pipeline": { "alarmDistance": 0.5, "contactDistance": 0.1, "mu": 0 },
        "Epidermis":    { "punctureForceThreshold": 3.0e8, "mu": 0.2,  "frictionCoeff": 5e-4, "scaleComplianceMatrix": true,
                          "trajectories": ["@/NeedleInsertionComponents/EpidermisROI"] },
        "Subcutaneous": { "punctureForceThreshold": 5.0e8, "mu": 0.01, "frictionCoeff": 1e-5, "scaleComplianceMatrix": true,
                          "trajectories": ["@/NeedleInsertionComponents/SubcutaneousROI"] },
        "Skull":        { "mu": 0.02 }
    }
}
